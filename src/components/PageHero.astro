---
interface Props {
  title: string;
  kicker?: string;
  intro?: string;
  bgImage?: string;
}

const { 
  title, 
  kicker = "MonetaLab International", 
  intro,
  bgImage = "/images/billets-de-banque.jpg"
} = Astro.props;
---

<section class="relative isolate flex min-h-[420px] items-start justify-center overflow-hidden bg-[#071322] text-center text-white sm:min-h-[480px] lg:min-h-[540px]">
  <!-- Image d'arrière-plan avec zoom doux -->
  <img
    src={bgImage}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover opacity-25 filter blur-[0.5px] scale-105 transition-transform duration-1000"
  />

  <!-- Superposition gradient luxueux & motif de sécurité -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#071322]/90 via-[#0b1d32]/80 to-[#071322]/95" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(201,145,25,0.18),rgba(255,255,255,0))]" aria-hidden="true"></div>

  <!-- Contenu centré avec animation d'apparition et dégagement complet du header -->
  <div class="relative mx-auto max-w-4xl px-5 pb-16 pt-[180px] sm:pt-[220px] lg:pt-[285px] lg:px-8">
    <!-- Kicker / Badge -->
    <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-1.5 text-xs font-semibold tracking-wider uppercase text-[#f2d38c] backdrop-blur-md">
      <span class="h-1.5 w-1.5 rounded-full bg-[#f2d38c] pulse-dot" aria-hidden="true"></span>
      <span>{kicker}</span>
    </div>

    <!-- Fil d'Ariane -->
    <nav aria-label="Fil d'Ariane" class="mt-4 flex items-center justify-center gap-2 text-xs font-medium text-white/70 sm:text-sm">
      <a href="/" class="transition-colors hover:text-white">Accueil</a>
      <span class="text-white/40" aria-hidden="true">/</span>
      <span class="text-white font-semibold">{title}</span>
    </nav>

    <!-- Titre Principal de la page -->
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl drop-shadow-sm">
      {title}
    </h1>

    {intro && (
      <p class="mx-auto mt-5 max-w-2xl text-base text-white/85 sm:text-lg leading-relaxed font-light">
        {intro}
      </p>
    )}
  </div>

  <!-- Ligne séparatrice avec effet brillant au bas du hero -->
  <div class="absolute bottom-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-[#c99119]/40 to-transparent" aria-hidden="true"></div>
</section>
