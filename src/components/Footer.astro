---
import { site, footerNav, contact } from "../data/site";
import { serviceTopics } from "../data/services";
---

<footer class="site-footer mt-auto text-white">
  <div class="site-footer-backdrop" aria-hidden="true"></div>
  <div class="site-footer-content mx-auto max-w-[1400px] px-5 py-14 lg:px-8 lg:py-16">
    <div class="footer-columns grid gap-10 md:grid-cols-2 lg:grid-cols-3 lg:gap-16">
      <section class="footer-column" aria-labelledby="footer-about-title">
        <h2 id="footer-about-title" class="footer-heading">À propos</h2>
        <p class="footer-about-copy">
          Notre expérience, notre savoir-faire et nos expertises en tant que laboratoire de chimie monétaire nous guident au quotidien à assurer des prestations de qualité à nos clients, qu'ils soient particuliers ou professionnels.
        </p>
        <a class="footer-whatsapp action-button" href={contact.whatsappHref} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.55 14.9L2.2 22l5.27-1.38A9.9 9.9 0 1 0 12.04 2Zm0 17.98a8.04 8.04 0 0 1-4.1-1.13l-.3-.18-3.13.82.84-3.05-.2-.32a8.06 8.06 0 1 1 6.89 3.86Zm4.42-6.04c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.1-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.4h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.68 2.56 4.06 3.58.57.25 1.02.4 1.37.5.58.18 1.1.15 1.52.09.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" fill="currentColor"/></svg>
          Nous écrire sur WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </section>

      <nav class="footer-column" aria-label="Liens utiles">
        <h2 class="footer-heading">Liens utiles</h2>
        <ul class="footer-useful-links">
          {serviceTopics.map((service) => (
            <li><a class="footer-link" href={`/services/${service.slug}`}>{service.menuLabel}</a></li>
          ))}
          <li><a class="footer-link" href="/contact">Nous contacter</a></li>
        </ul>
      </nav>

      <section class="footer-column" aria-labelledby="footer-quality-title">
        <h2 id="footer-quality-title" class="footer-heading">Démarche Qualité</h2>
        <p class="footer-quality-copy">
          La démarche qualité de notre entreprise place nos clients au centre de nos préoccupations. Nous recherchons l'innovation qui dynamisera nos services et sera le moteur de notre ambition.
        </p>
        <a class="footer-quality-link" href="/ressources">En savoir plus <span aria-hidden="true">→</span></a>
      </section>
    </div>

    <section class="footer-contact-section" aria-labelledby="footer-contact-title">
      <h2 id="footer-contact-title" class="footer-heading">Nos coordonnées</h2>
      <div class="footer-contact-row">
        <div class="footer-contact-item">
          <span class="footer-contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8"/></svg>
          </span>
          <span><strong>Adresse</strong><span>{contact.address}</span></span>
        </div>
        <a class="footer-contact-item" href={`mailto:${contact.email}`}>
          <span class="footer-contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span><strong>E-mail</strong><span>{contact.email}</span></span>
        </a>
        <a class="footer-contact-item" href={contact.phoneHref}>
          <span class="footer-contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M6.6 3.8 9.4 7l-1.8 2.2a15 15 0 0 0 7.2 7.2l2.2-1.8 3.2 2.8-.8 3.1a2 2 0 0 1-2.2 1.5C9.4 20.8 3.2 14.6 2 6.8a2 2 0 0 1 1.5-2.2l3.1-.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          </span>
          <span><strong>Téléphone</strong><span>{contact.phoneDisplay}</span></span>
        </a>
      </div>
    </section>
  </div>

  <div class="site-footer-bottom">
    <div
      class="mx-auto flex max-w-[1400px] flex-col gap-3 px-5 py-5 text-sm text-white/65 sm:flex-row sm:items-center sm:justify-between lg:px-8"
    >
      <p>© {new Date().getFullYear()} {site.name}. Tous droits réservés.</p>
      <ul class="flex flex-wrap gap-4">
        {
          footerNav.map((item) => (
            <li>
              <a class="footer-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #0b1d32;
  }

  .site-footer-backdrop {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image:
      linear-gradient(90deg, rgba(7, 20, 35, 0.96), rgba(7, 20, 35, 0.88)),
      url("/images/laboratoire-equipe.jpg");
    background-position: center 45%;
    background-size: cover;
  }

  .site-footer-content {
    position: relative;
  }

  .site-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(3, 12, 24, 0.38);
  }

  .footer-columns {
    padding-bottom: 3.5rem;
  }

  .footer-column {
    min-width: 0;
  }

  .footer-heading {
    position: relative;
    margin-bottom: 1.65rem;
    padding-bottom: 0.9rem;
    color: #fff;
    font-size: 1.45rem;
    font-weight: 700;
  }

  .footer-heading::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 52px;
    height: 3px;
    background: #5876c9;
    content: "";
  }

  .footer-about-copy,
  .footer-quality-copy {
    max-width: 28rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1rem;
    line-height: 1.8;
  }

  .footer-whatsapp {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    margin-top: 1.4rem;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .footer-whatsapp svg {
    width: 24px;
    height: 24px;
    color: #25d366;
  }

  .footer-whatsapp span {
    color: #a9bcff;
    transition: transform 180ms ease;
  }

  .footer-whatsapp:hover span,
  .footer-whatsapp:focus-visible span {
    transform: translate(2px, -2px);
  }

  .footer-useful-links {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.76);
    font-size: 1rem;
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
  }

  .footer-link::before {
    width: 0;
    height: 2px;
    margin-right: 0;
    background: #5876c9;
    content: "";
    transition: width 180ms ease, margin-right 180ms ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: #fff;
    transform: translateX(2px);
  }

  .footer-link:hover::before,
  .footer-link:focus-visible::before {
    width: 14px;
    margin-right: 9px;
  }

  .footer-quality-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 1.25rem;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-quality-link span {
    color: #a9bcff;
    transition: transform 180ms ease;
  }

  .footer-quality-link:hover span,
  .footer-quality-link:focus-visible span {
    transform: translateX(4px);
  }

  .footer-contact-section {
    padding: 2.5rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .footer-contact-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .footer-contact-item {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .footer-contact-item + .footer-contact-item {
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .footer-contact-item > span:last-child {
    display: grid;
    min-width: 0;
    gap: 0.35rem;
  }

  .footer-contact-item strong {
    color: #fff;
    font-size: 1.1rem;
  }

  .footer-contact-item > span:last-child > span {
    color: rgba(255, 255, 255, 0.76);
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  a.footer-contact-item:hover > span:last-child > span,
  a.footer-contact-item:focus-visible > span:last-child > span {
    color: #fff;
  }

  .footer-contact-icon {
    display: flex;
    width: 3.5rem;
    height: 3.5rem;
    flex: 0 0 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(169, 188, 255, 0.12);
    color: #a9bcff;
  }

  .footer-contact-icon svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  @media (max-width: 767px) {
    .footer-columns {
      padding-bottom: 2.5rem;
    }

    .footer-contact-row {
      grid-template-columns: 1fr;
    }

    .footer-contact-item {
      padding: 1rem 0;
    }

    .footer-contact-item + .footer-contact-item {
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      border-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-whatsapp,
    .footer-whatsapp span,
    .footer-link,
    .footer-link::before,
    .footer-quality-link span {
      transition: none;
    }
  }
</style>
