    .site-header #desktop-sticky-navigation > div > a {
      display: inline-flex;
      height: 100%;
      align-items: center;
      font-size: clamp(17px, 1.2vw, 22px);
      white-space: nowrap;
    }

    .site-header #desktop-sticky-navigation > .group {
      display: flex;
      height: 100%;
      align-items: stretch;
      padding: 0;
    }

    .desktop-sticky-quote {
      display: inline-flex;
      min-width: clamp(230px, 23vw, 405px);
      min-height: 82px;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 0 24px;
      background: #5876c9;
      color: #fff;
      font-size: clamp(17px, 1.2vw, 22px);
      font-weight: 700;
      text-decoration: none;
      transition: background-color 180ms ease;
    }

    .desktop-sticky-quote:hover,
    .desktop-sticky-quote:focus-visible {
      background: #4058a8;
    }

    .desktop-sticky-quote span {
      font-size: 1.35em;
      line-height: 1;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .site-header .header-shell {
      padding-right: 16px;
      padding-left: 16px;
    }

    .site-header .header-frame {
      grid-template-columns: minmax(0, 18%) minmax(0, 1fr);
      grid-template-rows: 122px 82px;
    }

    .site-header .header-brand {
      padding: 16px;
    }

    .site-header .header-info-contact:first-child {
      display: none;
    }

    .site-header .header-info-contact {
      padding: 14px;
    }

    .site-header .header-info-phone,
    .site-header .header-contact {
      width: 250px;
      flex-basis: 250px;
    }

    .site-header .header-nav-row {
      padding-left: 18px;
    }

    .site-header .header-nav-row nav {
      gap: 14px;
    }

    .site-header .header-nav-row nav > a,
    .site-header .header-nav-row nav > div > a {
      font-size: 16px;
    }

    .site-header .header-contact,
    .site-header .quote-button {
      height: 82px;
      min-height: 82px;
    }
  }

  @keyframes header-frame-enter {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes header-info-enter {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes nav-item-enter {
    from {
      opacity: 0;
      transform: translateY(9px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes sticky-header-enter {
    from {
      opacity: 0;
      transform: translateY(-100%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header .header-frame,
    .site-header .header-info,
    .site-header .header-nav-row nav > a,
    .site-header .header-nav-row nav > div {
      animation: none;
    }

    .site-header .header-nav-row nav > a::after,
    .site-header .header-nav-row nav > div > a::after,
    .site-header .desktop-sticky-header {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  const siteHeader = document.getElementById("site-header");
  const desktopNavigation = document.getElementById("desktop-navigation");
  const stickyNavigation = document.getElementById("desktop-sticky-navigation");

  if (desktopNavigation && stickyNavigation) {
    for (const item of desktopNavigation.children) {
      stickyNavigation.append(item.cloneNode(true));
    }
  }

  if (siteHeader) {
    const updateHeader = () => {
      const isDesktop = window.matchMedia("(min-width: 1024px)").matches;
      const isScrolled = window.scrollY >= (isDesktop ? 180 : 40);
      siteHeader.classList.toggle("is-scrolled", isScrolled);
      siteHeader.style.zIndex = isScrolled ? "50" : "";
      siteHeader.querySelector(".desktop-sticky-header")?.setAttribute("aria-hidden", String(!isDesktop || !isScrolled));
    };

    window.addEventListener("scroll", updateHeader, { passive: true });
    window.matchMedia("(min-width: 1024px)").addEventListener("change", updateHeader);
    updateHeader();
  }

  const menuToggle = document.getElementById("mobile-menu-toggle");
  const menuClose = document.getElementById("mobile-menu-close");
  const menuBackdrop = document.getElementById("mobile-menu-backdrop");
  const mobileNavigation = document.getElementById("mobile-navigation");
  const servicesToggle = document.getElementById("mobile-services-toggle");
  const servicesSubmenu = document.getElementById("mobile-services-submenu");

  if (
    menuToggle instanceof HTMLButtonElement &&
    menuClose instanceof HTMLButtonElement &&
    menuBackdrop instanceof HTMLButtonElement &&
    mobileNavigation instanceof HTMLElement
  ) {
    const closeMenu = () => {
      mobileNavigation.classList.remove("is-open");
      mobileNavigation.hidden = true;
      mobileNavigation.setAttribute("aria-hidden", "true");
      menuBackdrop.hidden = true;
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.setAttribute("aria-label", "Ouvrir le menu");
      if (servicesToggle instanceof HTMLButtonElement && servicesSubmenu instanceof HTMLElement) {
        servicesToggle.setAttribute("aria-expanded", "false");
        servicesToggle.setAttribute("aria-label", "Afficher les sous-services");
        servicesSubmenu.hidden = true;
      }
      document.body.style.removeProperty("overflow");
    };

    const openMenu = () => {
      mobileNavigation.hidden = false;
      mobileNavigation.setAttribute("aria-hidden", "false");
      menuBackdrop.hidden = false;
      menuToggle.setAttribute("aria-expanded", "true");
      menuToggle.setAttribute("aria-label", "Fermer le menu");
      document.body.style.overflow = "hidden";
      mobileNavigation.classList.add("is-open");
      menuClose.focus();
    };

    menuToggle.addEventListener("click", openMenu);
    menuClose.addEventListener("click", closeMenu);
    menuBackdrop.addEventListener("click", closeMenu);
    mobileNavigation.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !mobileNavigation.hidden) {
        closeMenu();
        menuToggle.focus();
      }
    });

    servicesToggle?.addEventListener("click", () => {
      if (!(servicesToggle instanceof HTMLButtonElement) || !(servicesSubmenu instanceof HTMLElement)) return;
      const expanded = servicesToggle.getAttribute("aria-expanded") === "true";
      servicesToggle.setAttribute("aria-expanded", String(!expanded));
      servicesToggle.setAttribute("aria-label", expanded ? "Afficher les sous-services" : "Masquer les sous-services");
      servicesSubmenu.hidden = expanded;
    });

    window.matchMedia("(min-width: 1024px)").addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>
