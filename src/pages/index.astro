  <!-- Script du Slider Hero, des Cartes de Services et du Compteur Chiffré -->
  <script>
    // ===== 1. SLIDER HERO AVEC BARRE DE PROGRESSION ET ANIMATION KEN BURNS =====
    const slider = document.getElementById("hero-slider");
    const heroKicker = document.getElementById("hero-kicker");
    const heroTitle = document.getElementById("hero-title");
    const heroDescription = document.getElementById("hero-description");
    const heroCtaText = document.getElementById("hero-cta-text");
    const heroCta = document.getElementById("hero-cta") as HTMLAnchorElement | null;
    const heroTextBlock = document.getElementById("hero-text-block");
    const progressBar = document.getElementById("hero-progress-bar");
    const slideCount = document.getElementById("hero-slide-count");
    const prevBtn = document.getElementById("hero-prev");
    const nextBtn = document.getElementById("hero-next");
    const dots = document.querySelectorAll("#hero-dots button");

    if (slider && heroTitle && heroDescription && heroCta && slideCount) {
      const backgrounds = Array.from(slider.querySelectorAll<HTMLElement>("[data-hero-background]"));
      const slides = backgrounds.map((bg) => ({
        kicker: bg.dataset.kicker ?? "Laboratoire International de Chimie Monétaire",
        title: bg.dataset.title ?? "",
        description: bg.dataset.description ?? "",
        cta: bg.dataset.cta ?? "En savoir plus",
        href: bg.dataset.href ?? "/",
      }));

      let activeIndex = 0;
      let progressTimer: number | undefined;
      let progressVal = 0;
      const durationMs = 4800;
      const stepMs = 50;

      const animateText = () => {
        if (!heroTextBlock) return;
        heroTextBlock.classList.remove("animate-fade-in-up");
        // Forcer le reflow pour relancer l'animation CSS
        void heroTextBlock.offsetWidth;
        heroTextBlock.classList.add("animate-fade-in-up");
      };

      const showSlide = (newIndex: number) => {
        activeIndex = (newIndex + slides.length) % slides.length;

        backgrounds.forEach((bg, idx) => {
          if (idx === activeIndex) {
            bg.classList.add("opacity-100", "scale-100", "kenburns-zoom");
            bg.classList.remove("opacity-0", "scale-105");
          } else {
            bg.classList.remove("opacity-100", "scale-100", "kenburns-zoom");
            bg.classList.add("opacity-0", "scale-105");
          }
        });

        if (heroKicker) heroKicker.textContent = slides[activeIndex].kicker;
        heroTitle.textContent = slides[activeIndex].title;
        heroDescription.textContent = slides[activeIndex].description;
        if (heroCtaText) heroCtaText.textContent = slides[activeIndex].cta;
        heroCta.href = slides[activeIndex].href;

        slideCount.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;

        dots.forEach((dot, i) => {
          if (i === activeIndex) {
            dot.classList.add("w-8", "bg-[#c99119]");
            dot.classList.remove("w-2.5", "bg-white/40");
          } else {
            dot.classList.remove("w-8", "bg-[#c99119]");
            dot.classList.add("w-2.5", "bg-white/40");
          }
        });

        animateText();
        resetProgress();
      };

      const resetProgress = () => {
        progressVal = 0;
        if (progressBar) progressBar.style.width = "0%";
      };

      const stopAutoplay = () => {
        if (progressTimer !== undefined) {
          window.clearInterval(progressTimer);
          progressTimer = undefined;
        }
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        progressTimer = window.setInterval(() => {
          progressVal += (stepMs / durationMs) * 100;
          if (progressBar) {
            progressBar.style.width = `${Math.min(progressVal, 100)}%`;
          }
          if (progressVal >= 100) {
            showSlide(activeIndex + 1);
          }
        }, stepMs);
      };

      prevBtn?.addEventListener("click", () => {
        showSlide(activeIndex - 1);
        startAutoplay();
      });

      nextBtn?.addEventListener("click", () => {
        showSlide(activeIndex + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          const index = parseInt((e.currentTarget as HTMLElement).dataset.slideIndex || "0", 10);
          showSlide(index);
          startAutoplay();
        });
      });

      slider.addEventListener("mouseenter", stopAutoplay);
      slider.addEventListener("mouseleave", startAutoplay);

      // Lancement initial
      resetProgress();
      startAutoplay();
    }

    // ===== 2. DÉFILEMENT AUTOMATIQUE DANS LES CARTES DE SERVICES =====
    const serviceCards = Array.from(document.querySelectorAll<HTMLElement>("[data-card-slideshow]"));
    serviceCards.forEach((card) => {
      const slides = Array.from(card.querySelectorAll<HTMLElement>("[data-card-slide]"));
      const counterEl = card.querySelector<HTMLElement>("[data-card-counter]");
      if (slides.length < 2) return;

      const offset = parseInt(card.getAttribute("data-card-offset") || "0", 10);
      let cur = offset % slides.length;

      const showSlideInCard = (idx: number) => {
        slides.forEach((s, i) => {
          if (i === idx) {
            s.classList.add("opacity-100", "scale-100");
            s.classList.remove("opacity-0", "scale-105");
          } else {
            s.classList.remove("opacity-100", "scale-100");
            s.classList.add("opacity-0", "scale-105");
          }
        });
        cur = idx;
        if (counterEl) {
          counterEl.textContent = `${String(cur + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
        }
      };

      showSlideInCard(cur);

      let timer = window.setInterval(() => {
        showSlideInCard((cur + 1) % slides.length);
      }, 3200);

      card.addEventListener("mouseenter", () => window.clearInterval(timer));
      card.addEventListener("mouseleave", () => {
        timer = window.setInterval(() => {
          showSlideInCard((cur + 1) % slides.length);
        }, 3200);
      });
    });

    // ===== 3. ANIMATION COMPTEUR NUMÉRIQUE SUR LES CHIFFRES CLÉS =====
    const statCounters = document.querySelectorAll<HTMLElement>("[data-stat-counter]");
    if (statCounters.length && "IntersectionObserver" in window) {
      const countObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const target = parseInt(el.dataset.target || "0", 10);
              const suffix = el.dataset.suffix || "";
              const duration = 1600;
              const start = performance.now();

              const updateCount = (now: number) => {
                const elapsed = now - start;
                const progress = Math.min(elapsed / duration, 1);
                // Ease-out cubic
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const currentVal = Math.round(target * easeOut);
                el.textContent = `${currentVal}${suffix}`;

                if (progress < 1) {
                  requestAnimationFrame(updateCount);
                } else {
                  el.textContent = `${target}${suffix}`;
                }
              };

              requestAnimationFrame(updateCount);
              obs.unobserve(el);
            }
          });
        },
        { threshold: 0.3 }
      );

      statCounters.forEach((counter) => countObserver.observe(counter));
    }
  </script>

