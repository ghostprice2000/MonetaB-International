---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Placeholder from "../components/Placeholder.astro";
---

<Layout title="Confidentialité">
  <PageHero
    title="Politique de confidentialité"
    intro="Données collectées, finalités, droits — contenu RGPD à rédiger."
  />
  <div class="mx-auto max-w-3xl space-y-4 px-5 py-14 lg:px-8">
    <Placeholder label="Données collectées" minHeight="8rem" />
    <Placeholder label="Finalités et conservation" minHeight="8rem" />
    <Placeholder label="Vos droits" minHeight="8rem" />
  </div>
</Layout>
