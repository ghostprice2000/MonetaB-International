---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { contact } from "../data/site";

const qualityPillars = [
  {
    iconSvg: `<svg class="h-8 w-8 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`,
    title: "Le client au centre de nos préoccupations",
    desc: "Nous recherchons l'innovation qui dynamisera nos services et sera le moteur de notre ambition pour toujours mieux satisfaire nos clients.",
  },
  {
    iconSvg: `<svg class="h-8 w-8 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="11" r="3"/></svg>`,
    title: "Excellence technique & Traitements doux",
    desc: "Utilisation de machines haute pression, nettoyage ultrasonique et solutions chimiques formulées pour préserver les billets sans altération.",
  },
  {
    iconSvg: `<svg class="h-8 w-8 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: "Transparence & Justification de la confiance",
    desc: "Évaluation objective, devis clair et détaillé sans frais dissimulés, respect strict des engagements pris.",
  },
  {
    iconSvg: `<svg class="h-8 w-8 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: "Sécurité & Discrétion absolue",
    desc: "Traitement confidentiel de toutes les opérations, respect de la vie privée et protection totale des données de nos clients.",
  },
];

const faqs = [
  {
    q: "Quels types de billets prenez-vous en charge pour le nettoyage ?",
    a: "Nous intervenons sur toutes les devises internationales (Euros, Dollars US, Livres Sterling, Yens, Francs CFA, etc.), qu'ils soient noircis, sécurisés, marqués, tachés ou endommagés.",
  },
  {
    q: "Qu'est-ce que la SSD Solution et la poudre d'activation ?",
    a: "La SSD Solution est un composé chimique de haute performance conçu pour dissoudre et extraire les encres de sécurisation ou les macules sans détruire les fibres de coton ni les dispositifs de sécurité du billet. La poudre d'activation permet de réactiver la réaction chimique pour un décapage homogène.",
  },
  {
    q: "Proposez-vous du matériel à la location ou à la vente ?",
    a: "Oui, nous proposons une gamme complète d'équipements : machines automatiques de nettoyage, systèmes à ultrasons, kits de nettoyage manuels et réactifs chimiques certifiés, accompagnés de formations d'utilisation.",
  },
  {
    q: "Comment obtenir un devis ou une estimation ?",
    a: "Il vous suffit de nous contacter via WhatsApp ou notre formulaire en ligne en précisant le type de billets, la devise et le volume. Notre équipe vous répondra rapidement avec une proposition sur mesure.",
  },
];
---

<Layout
  title="Démarche Qualité — Standards Internationaux"
  description="Notre démarche qualité garantit des protocoles rigoureux pour le nettoyage de billets et les traitements chimiques. Certifications, traçabilité et accompagnement client personnalisé."
  keywords="démarche qualité laboratoire, certifications chimie monétaire, protocoles nettoyage billets, standards internationaux traitement fiduciaire"
>
  <PageHero
    title="Démarche Qualité & Engagements"
    kicker="Laboratoire International de Chimie Monétaire"
    intro="La démarche qualité de notre entreprise place nos clients au centre de nos préoccupations pour toujours mieux satisfaire leurs exigences."
  />

  <!-- SECTION PILIERS QUALITÉ (Sans emoji) -->
  <section class="reveal mx-auto max-w-[1400px] px-5 py-20 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <span class="rounded-full bg-[#c99119]/15 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#c99119]">
        Nos Engagements
      </span>
      <h2 class="mt-4 text-3xl font-extrabold text-[#0b1727] sm:text-4xl lg:text-5xl">
        Une Démarche Qualité Tournée Vers l'Excellence
      </h2>
      <p class="mt-4 text-base text-[#64748b] sm:text-lg">
        La démarche qualité de notre entreprise place nos clients au centre de nos préoccupations. Nous recherchons l'innovation qui dynamisera nos services et qui sera le moteur de notre ambition de toujours mieux satisfaire nos clients et de justifier leur confiance.
      </p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2">
      {qualityPillars.map((pillar) => (
        <div class="card-hover-effect flex items-start gap-5 rounded-2xl border border-[#e2e8f0] bg-white p-8 shadow-sm">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-slate-50 border border-slate-100 shadow-sm">
            <Fragment set:html={pillar.iconSvg} />
          </div>
          <div>
            <h3 class="text-xl font-bold text-[#0b1727]">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[#64748b]">{pillar.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION FAQ -->
  <section class="reveal bg-slate-50 py-20 lg:py-28">
    <div class="mx-auto max-w-4xl px-5 lg:px-8">
      <div class="text-center">
        <span class="rounded-full bg-blue-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-blue-700">
          Questions Fréquentes
        </span>
        <h2 class="mt-4 text-3xl font-extrabold text-[#0b1727] sm:text-4xl">
          Foire Aux Questions
        </h2>
        <p class="mt-3 text-base text-[#64748b]">
          Retrouvez les réponses aux questions les plus courantes sur nos produits et prestations.
        </p>
      </div>

      <div class="mt-12 space-y-4">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm transition open:shadow-md">
            <summary class="flex cursor-pointer items-center justify-between font-bold text-[#0b1727] text-base hover:text-[#c99119]">
              <span>{faq.q}</span>
              <span class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180 text-[#c99119]">▼</span>
            </summary>
            <p class="mt-4 text-sm leading-relaxed text-[#64748b] border-t border-slate-100 pt-4">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNIÈRE CONTACT -->
  <section class="reveal mx-auto max-w-[1400px] px-5 py-16 lg:px-8">
    <div class="rounded-3xl bg-gradient-to-r from-[#071322] to-[#173b5b] p-8 sm:p-14 text-white text-center shadow-xl">
      <h2 class="text-3xl font-extrabold sm:text-4xl">Une question spécifique sur vos billets ?</h2>
      <p class="mx-auto mt-4 max-w-xl text-base text-white/80">
        Nos techniciens sont à votre disposition pour vous conseiller et vous établir un devis rapide.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={contact.whatsappHref}
          target="_blank"
          rel="noreferrer"
          class="action-button inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-7 py-3.5 text-sm font-bold text-white hover:bg-[#20ba59]"
        >
          Discuter sur WhatsApp
        </a>
        <a
          href="/contact"
          class="action-button inline-flex items-center gap-2 rounded-xl border border-white/40 px-7 py-3.5 text-sm font-semibold text-white hover:bg-white/10"
        >
          Demander un devis en ligne
        </a>
      </div>
    </div>
  </section>
</Layout>
