---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { contact } from "../data/site";

const tips = [
  {
    iconSvg: `<svg class="h-6 w-6 text-[#c99119]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>`,
    title: "Lumière naturelle",
    desc: "Photographiez à la lumière du jour sans reflet direct pour révéler l'état réel.",
  },
  {
    iconSvg: `<svg class="h-6 w-6 text-[#c99119]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>`,
    title: "Recto & Verso",
    desc: "Prenez une photo nette à plat des deux faces complètes du billet.",
  },
  {
    iconSvg: `<svg class="h-6 w-6 text-[#c99119]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    title: "Détail net",
    desc: "Cadrez les zones marquées, filigranes ou décolorations sans flou.",
  },
  {
    iconSvg: `<svg class="h-6 w-6 text-[#c99119]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: "Ne pas altérer",
    desc: "Conservez le billet intact sans tenter de manipulation préalable.",
  },
];
---

<Layout
  title="Contactez-nous — Devis Gratuit"
  description="Contactez le Laboratoire International de Chimie Monétaire pour un devis gratuit. Nettoyage billets, SSD solution, traitement fiduciaire. Disponible par WhatsApp, téléphone ou formulaire. Réponse sous 24h."
  keywords="contact laboratoire chimie monétaire, devis nettoyage billets, WhatsApp laboratoire, contacter MonetaB, devis SSD solution"
>
  <PageHero
    title="Contactez Notre Laboratoire"
    kicker="Laboratoire International de Chimie Monétaire"
    intro="Nos spécialistes et techniciens certifiés sont à votre écoute pour vous conseiller et vous établir un devis personnalisé."
  />

  <section class="reveal contact-section mx-auto max-w-[1300px] px-5 py-16 sm:py-20 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-50 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-emerald-700">
        <span class="h-2 w-2 rounded-full bg-emerald-500 pulse-dot" aria-hidden="true"></span>
        <span>Service Technique Disponible en Direct</span>
      </div>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-[#0b1727] sm:text-4xl lg:text-5xl">
        Parlons de Votre Demande en Toute Confidentialité
      </h2>
      <p class="mt-4 text-base leading-relaxed text-[#64748b] sm:text-lg">
        Sélectionnez votre canal préféré : échange direct sur WhatsApp ou formulaire de demande de devis ci-dessous.
      </p>
    </div>

    <!-- Grille Coordonnées + Formulaire -->
    <div class="grid items-start gap-10 lg:grid-cols-[0.85fr_1.15fr]">
      <aside class="space-y-6">
        <!-- Carte WhatsApp -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0b1d32] to-[#173b5b] p-8 text-white shadow-xl">
          <div class="flex items-center justify-between">
            <span class="rounded-lg bg-emerald-500/20 px-3 py-1 text-xs font-bold text-emerald-400">
              Canal Recommandé
            </span>
            <span class="text-xs text-white/70">Réponse &lt; 15 min</span>
          </div>

          <div class="mt-6 flex items-center gap-4">
            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-[#25D366] text-white shadow-lg pulse-whatsapp">
              <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2a9.9 9.9 0 0 0-8.55 14.9L2.2 22l5.27-1.38A9.9 9.9 0 1 0 12.04 2Zm0 17.98a8.04 8.04 0 0 1-4.1-1.13l-.3-.18-3.13.82.84-3.05-.2-.32a8.06 8.06 0 1 1 6.89 3.86Zm4.42-6.04c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.1-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.4h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.68 2.56 4.06 3.58.57.25 1.02.4 1.37.5.58.18 1.1.15 1.52.09.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold">Assistance WhatsApp</h3>
              <p class="text-xs text-white/80 mt-0.5">Échange direct avec nos techniciens</p>
            </div>
          </div>

          <p class="mt-5 text-sm text-white/85 leading-relaxed">
            Transmettez-nous vos photos pour un diagnostic immédiat ou pour convenir des modalités de traitement.
          </p>

          <a
            href={contact.whatsappHref}
            target="_blank"
            rel="noreferrer"
            class="action-button mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] py-3.5 text-sm font-bold text-white shadow-lg transition hover:bg-[#20ba59]"
          >
            <span>Démarrer la conversation WhatsApp</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Coordonnées Détaillées (strictement conservées) -->
        <div class="space-y-3">
          <a href={contact.phoneHref} class="card-hover-effect flex items-center gap-4 rounded-2xl border border-[#e2e8f0] bg-white p-5 shadow-sm">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-[#5876c9]">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-[#64748b]">Ligne directe</p>
              <p class="text-base font-bold text-[#0b1727]">{contact.phoneDisplay}</p>
            </div>
          </a>

          <a href={`mailto:${contact.email}`} class="card-hover-effect flex items-center gap-4 rounded-2xl border border-[#e2e8f0] bg-white p-5 shadow-sm">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            <div class="min-w-0">
              <p class="text-xs font-bold uppercase tracking-wider text-[#64748b]">Courrier électronique</p>
              <p class="text-base font-bold text-[#0b1727] truncate">{contact.email}</p>
            </div>
          </a>

          <div class="flex items-center gap-4 rounded-2xl border border-[#e2e8f0] bg-white p-5 shadow-sm">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-[#64748b]">Adresse physique</p>
              <p class="text-sm font-bold text-[#0b1727]">{contact.address}</p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Formulaire Sécurisé -->
      <div class="rounded-3xl border border-[#e2e8f0] bg-white p-8 sm:p-10 shadow-xl">
        <div class="border-b border-slate-100 pb-5">
          <span class="rounded-md bg-blue-50 px-2.5 py-1 text-xs font-bold text-blue-700">Formulaire Sécurisé</span>
          <h3 class="mt-2 text-2xl font-bold text-[#0b1727]">Demande de Devis & Contact</h3>
          <p class="mt-1 text-xs text-[#64748b]">Remplissez ce formulaire pour être recontacté directement sur WhatsApp ou par e-mail.</p>
        </div>

        <form id="whatsapp-contact-form" data-whatsapp={contact.whatsappHref} class="mt-6 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-[#334155]">Nom & Prénom *</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="Votre nom"
                class="mt-2 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-[#0b1727] outline-none transition focus:border-[#c99119] focus:bg-white focus:ring-2 focus:ring-[#c99119]/20"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-[#334155]">E-mail *</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="vous@exemple.com"
                class="mt-2 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-[#0b1727] outline-none transition focus:border-[#c99119] focus:bg-white focus:ring-2 focus:ring-[#c99119]/20"
              />
            </div>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="contact-phone" class="block text-xs font-bold uppercase tracking-wider text-[#334155]">Téléphone (Facultatif)</label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                placeholder="+33 ..."
                class="mt-2 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-[#0b1727] outline-none transition focus:border-[#c99119] focus:bg-white focus:ring-2 focus:ring-[#c99119]/20"
              />
            </div>
            <div>
              <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-[#334155]">Objet de la prestation *</label>
              <select
                id="contact-subject"
                name="subject"
                required
                class="mt-2 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-[#0b1727] outline-none transition focus:border-[#c99119] focus:bg-white focus:ring-2 focus:ring-[#c99119]/20"
              >
                <option value="" disabled selected>Sélectionnez un service</option>
                <option value="Nettoyage de billets">Nettoyage de billets sécurisés</option>
                <option value="Impression de billets">Impression de billets</option>
                <option value="Matériels et Produits">Matériels et Produits (SSD Solution)</option>
                <option value="Consulting / Conseils">Consulting & Conseils</option>
                <option value="Autre demande">Autre demande</option>
              </select>
            </div>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-[#334155]">Votre Message *</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Précisez votre demande (devises concernées, volume, localisation, type de traitement souhaité)..."
              class="mt-2 w-full rounded-xl border border-slate-300 bg-slate-50/50 px-4 py-3 text-sm text-[#0b1727] outline-none transition focus:border-[#c99119] focus:bg-white focus:ring-2 focus:ring-[#c99119]/20"
            ></textarea>
          </div>

          <button
            type="submit"
            class="action-button flex w-full items-center justify-center gap-2 rounded-xl bg-[#0b1d32] py-4 text-sm font-bold text-white shadow-lg transition hover:bg-[#173b5b] active:scale-98"
          >
            <span>Envoyer la demande sur WhatsApp</span>
            <span aria-hidden="true">→</span>
          </button>

          <p class="text-center text-xs text-[#64748b]">
            Confidentialité totale : Vos informations ne sont transmises à aucun tiers.
          </p>
        </form>
      </div>
    </div>

    <!-- RECOMMANDATIONS POUR LES PHOTOS SANS EMOJI -->
    <div class="mt-20 rounded-3xl bg-slate-50 p-8 sm:p-12 border border-[#e2e8f0]">
      <div class="text-center">
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 uppercase tracking-wider">
          Recommandations Pratiques
        </span>
        <h3 class="mt-3 text-2xl font-bold text-[#0b1727]">Comment Nous Envoyer des Photos Exploitables ?</h3>
        <p class="mt-2 text-sm text-[#64748b]">Suivez ces étapes simples pour un diagnostic précis et rapide.</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {tips.map((tip) => (
          <div class="rounded-2xl border border-[#e2e8f0] bg-white p-6 shadow-sm text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50/60 border border-amber-100">
              <Fragment set:html={tip.iconSvg} />
            </div>
            <h4 class="mt-3 text-sm font-bold text-[#0b1727]">{tip.title}</h4>
            <p class="mt-1.5 text-xs text-[#64748b] leading-relaxed">{tip.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Script WhatsApp -->
  <script>
    const form = document.getElementById("whatsapp-contact-form");

    if (form instanceof HTMLFormElement) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const name = String(formData.get("name") ?? "").trim();
        const email = String(formData.get("email") ?? "").trim();
        const phone = String(formData.get("phone") ?? "").trim();
        const subject = String(formData.get("subject") ?? "").trim();
        const message = String(formData.get("message") ?? "").trim();

        const baseWhatsapp = form.dataset.whatsapp || "https://wa.me/33748233262";
        const url = new URL(baseWhatsapp);

        const text = `Bonjour Laboratoire International de Chimie Monétaire,\n\nNom : ${name}\nE-mail : ${email}${phone ? `\nTéléphone : ${phone}` : ""}\nPrestation : ${subject}\n\nMessage :\n${message}`;

        url.searchParams.set("text", text);
        window.open(url.toString(), "_blank", "noopener,noreferrer");
      });
    }
  </script>
</Layout>
