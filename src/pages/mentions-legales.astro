---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Placeholder from "../components/Placeholder.astro";
---

<Layout title="Mentions légales">
  <PageHero title="Mentions légales" intro="Éditeur, hébergeur, propriété intellectuelle — textes juridiques à insérer." />
  <div class="mx-auto max-w-3xl space-y-4 px-5 py-14 lg:px-8">
    <Placeholder label="Éditeur du site" minHeight="8rem" />
    <Placeholder label="Hébergement" minHeight="8rem" />
    <Placeholder label="Propriété intellectuelle" minHeight="8rem" />
  </div>
</Layout>
