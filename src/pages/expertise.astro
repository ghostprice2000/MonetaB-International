---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { contact } from "../data/site";

const technologies = [
  {
    iconSvg: `<svg class="h-7 w-7 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><circle cx="12" cy="11" r="3"/></svg>`,
    title: "Nettoyage Ultrasonique & Haute Pression",
    desc: "Équipements de pointe permettant un décapage homogène et minutieux des billets marqués sans altérer les fibres de sécurité.",
    badge: "Technologie Avancée",
  },
  {
    iconSvg: `<svg class="h-7 w-7 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`,
    title: "SSD Solution & Réactifs d'Activation",
    desc: "Formulations chimiques exclusives de haute efficacité pour la réhabilitation des billets sécurisés de toutes devises.",
    badge: "Formule Brevetée",
  },
  {
    iconSvg: `<svg class="h-7 w-7 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>`,
    title: "Impression Sécurisée de Haute Précision",
    desc: "Machines de reproduction fiduciaire avec intégration des encres OVI, filigranes et patchs de sécurité certifiés.",
    badge: "Haute Résolution",
  },
  {
    iconSvg: `<svg class="h-7 w-7 text-[#5876c9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/></svg>`,
    title: "Diagnostic et Contrôle Spectroscopique",
    desc: "Analyse des encres et de la structure du papier sous rayonnements UV et infrarouges pour garantir une parfaite régularité.",
    badge: "Contrôle Qualité",
  },
];

const expertiseDomains = [
  {
    title: "Décapage de Billets Sécurisés",
    desc: "Une solide réputation en Europe et en Afrique dans le traitement et la réhabilitation des billets noircis, masqués ou sécurisés.",
    points: [
      "Prise en charge de toutes les devises (EUR, USD, GBP, devises africaines)",
      "Préservation intégrale des caractéristiques physiques du papier",
      "Restauration de la lisibilité et de l'aspect d'origine",
    ],
  },
  {
    title: "Matériels & Machines Automatiques",
    desc: "Location et vente de systèmes de traitement complets pour les professionnels et particuliers exigeants.",
    points: [
      "Machines automatiques et semi-automatiques calibrées",
      "Kits complets de produits chimiques certifiés",
      "Formation technique complète et assistance continue",
    ],
  },
  {
    title: "Consulting & Accompagnement Dédié",
    desc: "Conseils techniques personnalisés pour chaque étape du traitement avec une garantie de discrétion absolue.",
    points: [
      "Diagnostic précis de l'état des billets",
      "Préconisation des produits et dosages adaptés",
      "Suivi personnalisé jusqu'à la réhabilitation complète",
    ],
  },
];
---

<Layout
  title="Expertise Monétaire"
  description="Laboratoire International de Chimie Monétaire — Expertise dans le traitement chimique, le décapage de billets sécurisés et les solutions fiduciaires."
>
  <PageHero
    title="Expertise & Savoir-Faire"
    kicker="Laboratoire International de Chimie Monétaire"
    intro="Notre expertise dans le traitement chimique des billets de banque nous permet de vous fournir des solutions efficaces pour réhabiliter vos billets de banque sécurisés."
  />

  <!-- PRÉSENTATION DE L'EXPERTISE -->
  <section class="reveal mx-auto max-w-[1400px] px-5 py-20 lg:px-8 lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full bg-[#c99119]/15 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#c99119]">
          Savoir-Faire International
        </span>
        <h2 class="mt-4 text-3xl font-extrabold text-[#0b1727] sm:text-4xl lg:text-5xl">
          Des Solutions Efficaces et Innovantes
        </h2>
        <p class="mt-5 text-base leading-relaxed text-[#475569] sm:text-lg">
          Le <strong>Laboratoire International de Chimie Monétaire</strong> s'appuie sur une équipe expérimentée composée de professeurs associés, conseillers et techniciens certifiés en chimie monétaire.
        </p>
        <p class="mt-4 text-base leading-relaxed text-[#475569]">
          Grâce à nos équipements de pointe et à des procédés chimiques rigoureusement testés, nous apportons une réponse rapide et personnalisée pour tous types de billets sécurisés, marqués ou endommagés.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/services"
            class="action-button inline-flex items-center gap-2 rounded-xl bg-[#0b1d32] px-6 py-3.5 text-sm font-bold text-white hover:bg-[#173b5b]"
          >
            Voir nos prestations
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={contact.whatsappHref}
            target="_blank"
            rel="noreferrer"
            class="action-button inline-flex items-center gap-2 rounded-xl border border-slate-300 px-6 py-3.5 text-sm font-semibold text-[#0b1727] hover:bg-slate-50"
          >
            Échanger sur WhatsApp
          </a>
        </div>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-2xl shadow-2xl border border-slate-200">
          <img
            src="/images/technique_net.jpg"
            alt="Équipement d'analyse et de traitement chimique"
            class="h-[440px] w-full object-cover transition-transform duration-700 hover:scale-105"
            loading="lazy"
          />
        </div>

        <div class="absolute -bottom-6 -left-4 max-w-[280px] rounded-2xl border border-white/50 bg-white/95 p-5 shadow-2xl backdrop-blur-md sm:bottom-6 sm:left-6">
          <p class="text-xs font-bold uppercase tracking-wider text-[#c99119]">Rigueur & Performance</p>
          <p class="mt-1 text-sm font-bold text-[#0b1727]">Traitements chimiques haute précision</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ÉQUIPEMENTS & TECHNOLOGIES SANS EMOJI -->
  <section class="reveal bg-slate-50 py-20 lg:py-28">
    <div class="mx-auto max-w-[1400px] px-5 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="rounded-full bg-blue-100 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-blue-700">
          Technologies & Matériels
        </span>
        <h2 class="mt-4 text-3xl font-extrabold text-[#0b1727] sm:text-4xl lg:text-5xl">
          Nos Outils d'Intervention
        </h2>
        <p class="mt-4 text-base text-[#64748b] sm:text-lg">
          Une combinaison de machines de pointe et de réactifs chimiques spécialement formulés.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {technologies.map((tech) => (
          <div class="card-hover-effect flex flex-col rounded-2xl border border-[#e2e8f0] bg-white p-7 shadow-sm">
            <div class="flex items-center justify-between">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-slate-50 border border-slate-100">
                <Fragment set:html={tech.iconSvg} />
              </div>
              <span class="rounded-md bg-slate-100 px-2.5 py-1 text-[11px] font-bold text-slate-700">
                {tech.badge}
              </span>
            </div>
            <h3 class="mt-5 text-lg font-bold text-[#0b1727]">{tech.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[#64748b] flex-1">{tech.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DOMAINES D'APPLICATION -->
  <section class="reveal mx-auto max-w-[1400px] px-5 py-20 lg:px-8 lg:py-28">
    <div class="mx-auto max-w-3xl text-center">
      <span class="rounded-full bg-[#c99119]/15 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#c99119]">
        Champs d'Action
      </span>
      <h2 class="mt-4 text-3xl font-extrabold text-[#0b1727] sm:text-4xl">
        Domaines d'Intervention Spécialisés
      </h2>
      <p class="mt-4 text-base text-[#64748b]">
        Des prestations sur-mesure pour les particuliers et professionnels.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {expertiseDomains.map((dom) => (
        <div class="card-hover-effect flex flex-col rounded-2xl border border-[#e2e8f0] bg-white p-8 shadow-md">
          <h3 class="text-xl font-bold text-[#0b1727]">{dom.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[#64748b]">{dom.desc}</p>

          <ul class="mt-6 space-y-3 border-t border-slate-100 pt-6">
            {dom.points.map((pt) => (
              <li class="flex items-start gap-2.5 text-xs font-medium text-[#475569]">
                <svg class="h-4 w-4 shrink-0 text-emerald-600 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{pt}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- BANNIÈRE -->
    <div class="mt-16 rounded-2xl bg-[#0b1d32] p-8 text-center text-white sm:p-12 shadow-xl">
      <h3 class="text-2xl font-bold sm:text-3xl">Besoin d'un diagnostic ou d'un devis immédiat ?</h3>
      <p class="mx-auto mt-3 max-w-2xl text-sm sm:text-base text-white/80">
        Notre équipe est à votre disposition sur WhatsApp pour étudier votre demande dans les plus brefs délais.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-4">
        <a
          href={contact.whatsappHref}
          target="_blank"
          rel="noreferrer"
          class="action-button inline-flex items-center gap-2 rounded-xl bg-[#25D366] px-6 py-3 text-sm font-bold text-white hover:bg-[#20ba59]"
        >
          Contacter sur WhatsApp
        </a>
        <a
          href="/contact"
          class="action-button inline-flex items-center gap-2 rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10"
        >
          Formulaire de contact
        </a>
      </div>
    </div>
  </section>
</Layout>
